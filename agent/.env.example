# sayou-agent configuration
# Copy to .env and fill in your keys

# Required: OpenAI API key for LLM
SAYOU_AGENT_OPENAI_API_KEY=sk-...

# Optional: Model (default: gpt-4o)
# SAYOU_AGENT_CHAT_MODEL=gpt-4o

# Optional: Tavily API key for web search
# SAYOU_AGENT_TAVILY_API_KEY=tvly-...

# Optional: E2B API key for sandbox execution
# SAYOU_AGENT_E2B_API_KEY=e2b_...

# Server settings
# SAYOU_AGENT_HOST=0.0.0.0
# SAYOU_AGENT_PORT=9008
# SAYOU_AGENT_DEBUG=false

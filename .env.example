# sayou Configuration
# Copy this file to .env and fill in your values

# Database (MySQL for production, SQLite for local dev)
SAYOU_DATABASE_URL=mysql+aiomysql://user:password@host:3306/sayou_dev
# SAYOU_DATABASE_URL=sqlite+aiosqlite:///./sayou.db

# S3 Storage
SAYOU_S3_BUCKET_NAME=pixell-agents
SAYOU_S3_REGION=us-east-2
SAYOU_S3_ACCESS_KEY_ID=your-access-key
SAYOU_S3_SECRET_ACCESS_KEY=your-secret-key
# SAYOU_S3_ENDPOINT_URL=http://localhost:9000  # For MinIO

# Identity (set by MCP config env vars)
SAYOU_ORG_ID=your-org-id
SAYOU_USER_ID=your-user-id
SAYOU_WORKSPACE_SLUG=default

# Agent Observer (post-session conversation extraction)
# Requires SAYOU_AGENT_OPENAI_API_KEY to be set
# SAYOU_AGENT_OBSERVER_ENABLED=true
# SAYOU_AGENT_OBSERVER_MODEL=gpt-4o-mini
